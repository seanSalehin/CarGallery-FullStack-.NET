@using Gateway_API_Client
@model CarsDTO

@{
    ViewData["Title"] = "Delete Car";
}

<section class="dashboard-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-8">
                <div class="delete-panel">
                    <div class="delete-hero">
                        @if (Model != null && !string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" />
                        }
                        else
                        {
                            <div class="empty-preview">
                                <i class="bi bi-car-front-fill"></i>
                            </div>
                        }
                    </div>
                    <div class="delete-content">
                        <span class="eyebrow text-danger">Danger zone</span>
                        <h1 style="color: #9ca3fa;">Delete @Model?.Name?</h1>
                        <p style="color: #9ca3fa;">This will remove the car from your gallery. Review the details before confirming.</p>
                        <div class="delete-stats">
                            <div>
                                <span>Price</span>
                                <strong>$@Model?.price.ToString("N0")</strong>
                            </div>
                            <div>
                                <span>Rating</span>
                                <strong>@Model?.Rate</strong>
                            </div>
                        </div>
                        <div class="delete-description">
                            @(string.IsNullOrWhiteSpace(Model?.Details) ? "No details available." : Model.Details)
                        </div>
                        <form action="/Car/Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <div class="form-actions justify-content-center">
                                <a href="/Car/Index" class="btn btn-outline-light-dark">
                                    <i class="bi bi-arrow-left me-2"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash3 me-2"></i>Delete Car
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
