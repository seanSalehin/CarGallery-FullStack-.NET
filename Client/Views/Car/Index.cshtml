@using Gateway_API_Client
@model IEnumerable<CarsDTO>

<div class="container my-4">
	<!-- Header -->
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="mb-1">Car Management</h2>
			<p class="text-muted mb-0">Manage your villa listings</p>
		</div>
		<a asp-controller="Car" asp-action="Create" class="btn btn-success">
			<i class="bi bi-plus-circle me-2"></i>Add New Car
		</a>
	</div>

	<!-- Messages -->
@if (TempData["success"] != null)
{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			<i class="bi bi-check-circle me-2"></i> Success
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
}

@if (TempData["error"] != null)
{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="bi bi-exclamation-triangle me-2"></i>Error
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
}

@if (Model == null || !Model.Any())
{
		<div class="alert alert-info text-center">
			<i class="bi bi-info-circle fs-1 d-block mb-3"></i>
			<h5>No Villas Available</h5>
			<p class="mb-3">Get started by creating your first villa.</p>
			<a href="#" class="btn btn-primary">
				<i class="bi bi-plus-circle me-2"></i>Create Villa
			</a>
		</div>
}
else
{
	@if (Model.Count() > 0)
	{

			<!-- Car Table -->
			<div class="card">
				<div class="card-body p-0">
					<div class="table-responsive">
						<table class="table table-hover mb-0">
							<thead class="table-light">
								<tr>
									<th>Image</th>
									<th>Name</th>
									<th>Details</th>
									<th>Price</th>
									<th class="text-center">Actions</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var car in Model)
								{
									<tr>
										<td>
											@if (!string.IsNullOrEmpty(car.ImageUrl))
											{
												<img src="@car.ImageUrl" class="rounded" style="width: 60px; height: 45px; object-fit: cover;">
											}
											else
											{
												<div class="bg-secondary rounded d-flex align-items-center justify-content-center text-white"
													 style="width: 60px; height: 45px;">
													<i class="bi bi-image"></i>
												</div>
											}
										</td>
										<td class="align-middle">
											<strong>@car.Name</strong>
										</td>
										<td class="align-middle">
											<small class="text-muted">
												@if (string.IsNullOrEmpty(car.Details))
												{
													<span class="fst-italic">No Details</span>
												}
												else
												{
													@(car.Details.Length > 50 ? car.Details.Substring(0, 50) + "...." : car.Details)
												}
											</small>
										</td>
										<td class="align-middle">
											<span class="badge bg-success">@car.price.ToString("N0")</span>
										</td>
										<td class="align-middle text-center">
											<div class="btn-group btn-group-sm">

												<a asp-action="Edit" asp-route-id="@car.Id"
												   class="btn btn-outline-warning" title="Edit">
													<i class="bi bi-pencil"></i>
												</a>
												<a asp-action="Delete" asp-route-id="@car.Id"
												   class="btn btn-outline-danger" title="Delete">
													<i class="bi bi-trash"></i>
												</a>
											</div>
										</td>
									</tr>
								}


							</tbody>
						</table>
					</div>
				</div>
			</div>

			<!-- Summary -->

	}
}
	

	<style>
		.object-fit-cover {
			object-fit: cover;
		}
	</style>
