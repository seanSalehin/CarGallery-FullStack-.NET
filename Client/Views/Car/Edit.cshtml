@using Gateway_API_Client
@model UpdateDTO


<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Form Card -->
            <div class="card">
                <div class="card-header bg-warning text-white d-flex justify-content-between align-items-center">
                    <span class="fw-semibold h-4 pt-1">(Edit Car)</span>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Id" />
                        <!-- Car Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Car Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name"  class="form-control" placeholder="Enter car name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <!-- Details -->
                        <div class="mb-3">
                            <label asp-for="Details" class="form-label">Description</label>
                            <textarea asp-for="Details"  class="form-control" rows="4"
                                      placeholder="Describe the villa"></textarea>
                            <span asp-validation-for="Details" class="text-danger small"></span>
                        </div>

                        <!-- Rate -->
                        <div class="mb-3">
                            <label asp-for="Rate" class="form-label">Rate</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Rate" type="number"  step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Rate" class="text-danger small"></span>
                        </div>

                        <!-- price (int) -->
                        <div class="mb-3">
                            <label asp-for="price" class="form-label">Price</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="price" type="number"  step="1" class="form-control" placeholder="0" />
                            </div>
                            <span asp-validation-for="price" class="text-danger small"></span>
                        </div>

                        <!-- Image URL -->
                        <div class="mb-4">
                            <label asp-for="ImageUrl" class="form-label">Image URL</label>
                            <input asp-for="ImageUrl"  class="form-control" placeholder="https://example.com/image.jpg" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="text-center mb-4">
                                <label>Current Image</label> <br/>
                                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-height : 300px;" />
                            </div>
                        }

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-controller="Car" asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check me-2"></i>Update Car
                            </button>
                        </div>


                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_validationScriptsPartial" />
}