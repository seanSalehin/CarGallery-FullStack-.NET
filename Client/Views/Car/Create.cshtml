@using Gateway_API_Client
@model CreateCarsDTO

@{
    ViewData["Title"] = "Create Car";
}

<section class="dashboard-page">
    <div class="container">
        <div class="page-heading">
            <div>
                <span class="eyebrow">Admin dashboard</span>
                <h1 style="color: #9ca3fa;">Add a new car</h1>
            </div>
            <a href="/Car/Index" class="btn btn-outline-light-dark">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
        </div>
        <div class="row justify-content-center">
            <div class="col-xl-9">
                <div class="form-panel">
                    <form action="/Car/Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger small mb-4"></div>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">Car name</label>
                                <input asp-for="Name" class="form-control app-input" placeholder="Toyota Supra" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Rate" class="form-label">Rating</label>
                                <div class="input-group app-input-group">
                                    <span class="input-group-text"><i class="bi bi-star-fill"></i></span>
                                    <input asp-for="Rate" type="number" step="0.01" class="form-control" placeholder="4.8" />
                                </div>
                                <span asp-validation-for="Rate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="price" class="form-label">Price</label>
                                <div class="input-group app-input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="price" type="number" step="1" class="form-control" placeholder="45000" />
                                </div>
                                <span asp-validation-for="price" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Details" class="form-label">Description</label>
                                <textarea asp-for="Details" class="form-control app-input" rows="5" placeholder="Describe the car, style, performance, and highlights"></textarea>
                                <span asp-validation-for="Details" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="ImageUrl" class="form-label">Image URL</label>
                                <input asp-for="ImageUrl" class="form-control app-input" placeholder="https://example.com/car.jpg" />
                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="form-actions">
                            <a href="/Car/Index" class="btn btn-outline-light-dark">Cancel</a>
                            <button type="submit" class="btn btn-brand">
                                <i class="bi bi-plus-circle me-2"></i>Create Car
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_validationScriptsPartial" />
}
