@{
    ViewData["Title"] = "Access Denied";
}

<section class="center-screen">
    <div class="status-card danger">
        <div class="status-icon">
            <i class="bi bi-shield-exclamation"></i>
        </div>
        <span class="eyebrow">Permission required</span>
        <h1>Access denied</h1>
        <p>You do not have permission to open this area. Login with an admin account or return to the gallery.</p>
        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
            <a asp-action="Index" asp-controller="Home" class="btn btn-brand">
                <i class="bi bi-house me-2"></i>Go Home
            </a>
            <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-light-dark">
                <i class="bi bi-box-arrow-in-right me-2"></i>Login
            </a>
        </div>
    </div>
</section>
