@using Gateway_API_Client
@model IEnumerable<CarsDTO>

@{
    ViewData["Title"] = "Gallery";
    var cars = Model?.ToList() ?? new List<CarsDTO>();
    var currentPage = ViewBag.Page is int viewPage ? viewPage : 1;
    var pageSize = ViewBag.PageSize is int currentPageSize ? currentPageSize : 6;
    var totalPages = ViewBag.TotalPages is int currentTotalPages ? currentTotalPages : 1;
    var totalRecords = ViewBag.TotalRecords is int currentTotalRecords ? currentTotalRecords : cars.Count;
    var filterBy = ViewBag.FilterBy as string ?? "";
    var filterQuery = ViewBag.FilterQuery as string ?? "";
    var sortBy = ViewBag.SortBy as string ?? "";
    var sortOrder = ViewBag.SortOrder as string ?? "asc";
    var startingPrice = cars.Any() ? cars.Min(c => c.price) : 0;
    var averageRating = cars.Any() ? cars.Average(c => c.Rate) : 0;
    totalPages = Math.Max(totalPages, 1);
    currentPage = Math.Clamp(currentPage, 1, totalPages);
    string PageLink(int targetPage)
    {
        return Url.Action("Index", new { page = targetPage, pageSize = pageSize, filterBy = filterBy, filterQuery = filterQuery, sortBy = sortBy, sortOrder = sortOrder }) ?? "#";
    }
}

<section class="hero-section">
    <div class="hero-orb hero-orb-one"></div>
    <div class="hero-orb hero-orb-two"></div>
    <div class="container">
        <div class="hero-grid">
            <div class="hero-copy">
                <span class="eyebrow"> Car gallery</span>
                <h1>Ready to get behind the wheel?</h1>
                <div class="hero-actions">
                    <a href="#cars" class="btn btn-brand btn-lg">
                        <i class="bi bi-stars me-2"></i>Enter Showroom
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Car/Index" class="btn btn-outline-light-dark btn-lg">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                        </a>
                    }
                </div>
                <div class="hero-stats">
                    <div>
                        <strong>@totalRecords</strong>
                        <span>Total cars</span>
                    </div>
                    <div>
                        <strong>$@startingPrice.ToString("N0")</strong>
                        <span>Starting from</span>
                    </div>
                    <div>
                        <strong>@averageRating.ToString("0.0")</strong>
                        <span>Average rating</span>
                    </div>
                </div>
            </div>
            <div class="hero-showcase">
                @{
                    var heroCar = cars.FirstOrDefault();
                }
                @if (heroCar != null && !string.IsNullOrWhiteSpace(heroCar.ImageUrl))
                {
                    <img src="@heroCar.ImageUrl" alt="@heroCar.Name" />
                }
                else
                {
                    <div class="hero-placeholder">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                }
                <div class="floating-card top-card">
                    <i class="bi bi-stars"></i>
                    <span> Showroom</span>
                </div>
                <div class="floating-card bottom-card">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Find Your Car</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="cars" class="gallery-section">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Search cockpit</span>
                <h2 style="color: #584563">Featured cars</h2>
            </div>
            <span class="pill-soft">Page @currentPage of @totalPages</span>
        </div>

        @if (TempData["error"] != null)
        {
            <div class="alert app-alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="feature-strip">
            <span><i class="bi bi-palette-fill"></i> Showroom</span>
            <span><i class="bi bi-sliders2"></i> Smart filtering</span>
        </div>

        <form method="get" action="/" class="filter-panel filter-panel-featured">
            <input type="hidden" name="page" value="1" />
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Search by</label>
                    <select name="filterBy" class="form-select app-input">
                        <option value="" selected="@(filterBy == "")">Any field</option>
                        <option value="name" selected="@(filterBy == "name")">Name</option>
                        <option value="details" selected="@(filterBy == "details")">Details</option>
                        <option value="rate" selected="@(filterBy == "rate")">Exact rating</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input name="filterQuery" value="@filterQuery" class="form-control app-input" placeholder="Tesla, Mustang, electric, 4.9" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Sort by</label>
                    <select name="sortBy" class="form-select app-input">
                        <option value="" selected="@(sortBy == "")">Default</option>
                        <option value="name" selected="@(sortBy == "name")">Name</option>
                        <option value="rate" selected="@(sortBy == "rate")">Rating</option>
                        <option value="price" selected="@(sortBy == "price")">Price</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Order</label>
                    <select name="sortOrder" class="form-select app-input">
                        <option value="asc" selected="@(sortOrder == "asc")">Ascending</option>
                        <option value="desc" selected="@(sortOrder == "desc")">Descending</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Page size</label>
                    <select name="pageSize" class="form-select app-input">
                        <option value="3" selected="@(pageSize == 3)">3</option>
                        <option value="6" selected="@(pageSize == 6)">6</option>
                        <option value="9" selected="@(pageSize == 9)">9</option>
                        <option value="12" selected="@(pageSize == 12)">12</option>
                    </select>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-brand">
                        <i class="bi bi-funnel me-2"></i>Apply
                    </button>
                    <a href="/" class="btn btn-outline-light-dark">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Reset
                    </a>
                </div>
            </div>
        </form>

        @if (!cars.Any())
        {
            <div class="empty-state">
                <i class="bi bi-car-front"></i>
                <h3>No cars available</h3>
                <p>No cars match the current filters. Reset the filters or check again later.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var car in cars)
                {
                    var details = string.IsNullOrWhiteSpace(car.Details) ? "No details available for this car yet." : car.Details;
                    <div class="col-md-6 col-xl-4">
                        <article class="car-card">
                            <div class="car-card-media">
                                @if (!string.IsNullOrWhiteSpace(car.ImageUrl))
                                {
                                    <img src="@car.ImageUrl" alt="@car.Name" />
                                }
                                else
                                {
                                    <div class="car-card-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                                <div class="price-badge">$@car.price.ToString("N0")</div>
                                <div class="rating-badge"><i class="bi bi-star-fill"></i>@car.Rate</div>
                            </div>
                            <div class="car-card-body">
                                <h3>@car.Name</h3>
                                <p>@details</p>
                                <a href="mailto:hello@dotnetmastery.com?subject=Car inquiry: @car.Name" class="btn btn-card-action">
                                    <i class="bi bi-send me-2"></i>Ask About This Car
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>

            <nav class="pagination-shell" aria-label="Car gallery pagination">
                <a class="btn btn-outline-light-dark @(currentPage <= 1 ? "disabled" : "")" href="@PageLink(currentPage - 1)">
                    <i class="bi bi-chevron-left me-1"></i>Previous
                </a>
                <ul class="pagination mb-0">
                    @for (var i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@PageLink(i)">@i</a>
                        </li>
                    }
                </ul>
                <a class="btn btn-outline-light-dark @(currentPage >= totalPages ? "disabled" : "")" href="@PageLink(currentPage + 1)">
                    Next<i class="bi bi-chevron-right ms-1"></i>
                </a>
            </nav>
        }
    </div>
</section>
