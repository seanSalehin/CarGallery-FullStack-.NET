@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="content-page">
    <div class="container">
        <div class="content-card">
            <span class="eyebrow">Privacy</span>
            <h1>Privacy Policy</h1>
            <p>Car Gallery uses account information only for authentication, authorization, and managing gallery access.</p>
            <div class="privacy-grid">
                <div>
                    <i class="bi bi-shield-lock"></i>
                    <h3>Authentication</h3>
                    <p>Your login session is used to keep protected areas available only to authorized users.</p>
                </div>
                <div>
                    <i class="bi bi-person-check"></i>
                    <h3>Role access</h3>
                    <p>Admin features are shown only to users with the correct role.</p>
                </div>
                <div>
                    <i class="bi bi-database-check"></i>
                    <h3>Gallery data</h3>
                    <p>Car listing data is used to display the public gallery and admin management pages.</p>
                </div>
            </div>
        </div>
    </div>
</section>
